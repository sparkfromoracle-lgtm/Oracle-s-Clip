# Oracle Clip Media Service Environment Configuration

# Environment & Server
ENVIRONMENT=production
PORT=3000
API_HOST=0.0.0.0

# Authentication & Multi-Tenancy (Format: key1:tenant1,key2:tenant2)
API_KEYS=oracle_sec_live_key_alpha:tenant_alpha,oracle_sec_live_key_beta:tenant_beta
SERVICE_API_KEY=oracle_sec_live_key_alpha
DEFAULT_TENANT_ID=tenant_alpha

# Webhook Security (HMAC-SHA256)
WEBHOOK_SECRET=your_production_hmac_sha256_webhook_secret_minimum_16_chars
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# Media Binaries & Timeouts
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
RENDERING_TIMEOUT_SECONDS=180

# Provider Selection ('mock', 'local', 'faster_whisper' for ASR; 'mock', 'open_clip' for CLIP)
ASR_PROVIDER=mock
CLIP_PROVIDER=mock

# Storage Backend ('local' or 's3')
STORAGE_BACKEND=local
LOCAL_STORAGE_BASE_DIR=/app/storage

# S3 Configuration (Required if STORAGE_BACKEND=s3)
S3_BUCKET_NAME=oracle-clip-rendered-assets
S3_ENDPOINT_URL=
S3_REGION_NAME=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# CORS
CORS_ALLOWED_ORIGINS=*
